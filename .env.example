# Copy this file to .env.local (local) and add the same keys in Vercel → Project → Settings → Environment Variables.

# Your final URL. Used for SEO tags, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Contact form (optional). Create a free key at resend.com.
# Without these two, the form tells visitors to email you directly instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
